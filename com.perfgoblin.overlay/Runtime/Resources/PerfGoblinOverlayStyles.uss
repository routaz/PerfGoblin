.perfgoblin-overlay {
    position: absolute;
    width: 280px;
    background-color: rgba(15, 23, 42, 0.92);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(30, 41, 59, 1);
    padding: 12px;
    overflow: hidden;
    color: rgb(226, 232, 240);
    -unity-font-style: normal;
}

/* Header */
.pp-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(30, 41, 59, 0.5);
}

.pp-title {
    font-size: 9px;
    color: rgb(34, 197, 94);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.pp-version {
    font-size: 8px;
    color: rgba(148, 163, 184, 0.6);
    margin-right: 6px;
}

.pp-minimize-btn {
    font-size: 12px;
    color: rgba(148, 163, 184, 0.6);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.15);
    border-radius: 3px;
    width: 16px;
    height: 16px;
    -unity-text-align: middle-center;
    cursor: link;
}

.pp-minimize-btn:hover {
    color: rgb(226, 232, 240);
    border-color: rgba(148, 163, 184, 0.4);
    background-color: rgba(148, 163, 184, 0.1);
}

/* Panels */
.pp-panel {
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(30, 41, 59, 0.5);
}

.pp-panel-last {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom-width: 0;
}

.pp-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.pp-panel-label {
    font-size: 8px;
    color: rgba(148, 163, 184, 0.8);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* FPS Panel */
.pp-fps-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 4px;
}

.pp-fps-value {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(34, 197, 94);
    margin-right: 4px;
}

.pp-fps-target {
    font-size: 11px;
    color: rgba(148, 163, 184, 0.6);
    padding-bottom: 4px;
}

.pp-fps-ms {
    font-size: 11px;
    color: rgba(148, 163, 184, 0.8);
    padding-bottom: 4px;
    margin-left: auto;
}

.pp-fps-minmax {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.pp-fps-stat {
    font-size: 9px;
    color: rgba(148, 163, 184, 0.6);
}

.pp-fps-graph {
    height: 40px;
    background-color: rgba(30, 41, 59, 0.3);
    border-radius: 4px;
}

/* Memory Panel */
.pp-mem-mode {
    font-size: 7px;
    color: rgba(34, 197, 94, 0.6);
    margin-left: 4px;
}

.pp-mem-toggle {
    font-size: 8px;
    color: rgba(148, 163, 184, 0.5);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.2);
    border-radius: 3px;
    padding: 1px 4px;
    margin-right: 6px;
    cursor: link;
}

.pp-mem-toggle.active {
    color: rgb(34, 197, 94);
    border-color: rgba(34, 197, 94, 0.4);
    background-color: rgba(34, 197, 94, 0.08);
}
.pp-mem-total {
    font-size: 11px;
    color: rgb(226, 232, 240);
    -unity-font-style: bold;
}

.pp-mem-bar {
    height: 12px;
    flex-direction: row;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 6px;
    background-color: rgba(30, 41, 59, 0.5);
}

.pp-mem-segment {
    height: 100%;
}

.pp-mem-legend {
    flex-direction: row;
    flex-wrap: wrap;
}

.pp-mem-legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
    margin-bottom: 2px;
}

.pp-mem-legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 3px;
}

.pp-mem-legend-label {
    font-size: 8px;
    color: rgba(148, 163, 184, 0.6);
}

/* Scripts Panel */
.pp-scripts-count {
    font-size: 9px;
    color: rgba(148, 163, 184, 0.6);
}

.pp-scripts-list {
    max-height: 150px;
    overflow: scroll;
}

.pp-script-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-radius: 3px;
    margin-bottom: 1px;
}

.pp-script-row.status-bad {
    background-color: rgba(239, 68, 68, 0.08);
}

.pp-script-row.status-warn {
    background-color: rgba(245, 158, 11, 0.03);
}

.pp-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 6px;
    flex-shrink: 0;
}

.pp-status-dot.status-ok {
    background-color: rgb(34, 197, 94);
}

.pp-status-dot.status-warn {
    background-color: rgb(245, 158, 11);
}

.pp-status-dot.status-bad {
    background-color: rgb(239, 68, 68);
}

.pp-script-name {
    font-size: 10px;
    color: rgb(226, 232, 240);
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
}

.pp-script-ms {
    font-size: 10px;
    color: rgba(148, 163, 184, 0.8);
    flex-shrink: 0;
    margin-left: 6px;
    min-width: 40px;
    -unity-text-align: upper-right;
}

/* Spikes Panel */
.pp-spikes-badge {
    font-size: 9px;
    color: rgba(148, 163, 184, 0.6);
}

.pp-spikes-list {
    max-height: 150px;
    overflow: scroll;
}

.pp-spike-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    margin-bottom: 1px;
    border-radius: 3px;
    background-color: rgba(239, 68, 68, 0.05);
}

.pp-spike-frame {
    font-size: 9px;
    color: rgba(148, 163, 184, 0.5);
    margin-right: 6px;
    min-width: 28px;
}

.pp-spike-ms {
    font-size: 10px;
    color: rgb(239, 68, 68);
    -unity-font-style: bold;
    margin-right: 6px;
    min-width: 42px;
}

.pp-spike-offender {
    font-size: 9px;
    color: rgba(226, 232, 240, 0.7);
    flex-grow: 1;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
}

/* FPS color classes */
.fps-good {
    color: rgb(34, 197, 94);
}

.fps-warn {
    color: rgb(245, 158, 11);
}

.fps-bad {
    color: rgb(239, 68, 68);
}
